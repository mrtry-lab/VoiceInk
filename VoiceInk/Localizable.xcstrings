    "Delete old recordings while keeping transcript history.": {
      "comment": "A description of the audio cleanup process.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte Aufnahmen löschen, aber den Transkriptverlauf behalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こし履歴を残したまま、古い録音を削除します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除旧录音，同时保留转写历史记录。"
          }
        }
      }
    },
    "Delete transcript history and related audio files after the retention period.": {
      "comment": "A description of the transcription cleanup feature.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkriptverlauf und zugehörige Audiodateien nach Ablauf der Aufbewahrungsfrist löschen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保持期間の経過後に、文字起こし履歴と関連する音声ファイルを削除します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在保留期后删除转写历史记录和相关音频文件。"
          }
        }
      }
    },
