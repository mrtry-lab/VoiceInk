    "Use this when you want the quickest possible voice-to-text result. It records with your configured transcription model and pastes the transcript as-is.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende dies, wenn du möglichst schnell Sprache in Text umwandeln möchtest. Es nimmt mit deinem konfigurierten Transkriptionsmodell auf und fügt das Transkript unverändert ein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声からテキストへの変換を最速で行いたいときに使います。設定した文字起こしモデルで録音し、文字起こし結果をそのままペーストします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你想尽快将语音转换为文本时使用此模式。它会使用你配置的转写模型录音，并按原样粘贴转写内容。"
          }
        }
      }
    },
