    },
    "The downloaded Core ML model archive might be corrupted. Try deleting the model and downloading it again. Check available disk space.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das heruntergeladene Core-ML-Modellarchiv ist möglicherweise beschädigt. Lösche das Modell und lade es erneut herunter. Prüfe den verfügbaren Speicherplatz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードした Core ML モデルのアーカイブが破損している可能性があります。モデルを削除してから再ダウンロードしてください。空きディスク容量も確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的 Core ML 模型压缩包可能已损坏。请尝试删除该模型后重新下载。请检查可用磁盘空间。"
          }
        }
      }
    },
    "The downloaded file for %@ failed integrity verification.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Integritätsprüfung der heruntergeladenen Datei für %@ ist fehlgeschlagen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のダウンロードファイルは整合性検証に失敗しました。"
          }
