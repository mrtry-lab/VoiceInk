        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk 默认保护隐私"
          }
        }
      }
    },
    "VoiceInk is private by default. No data leaves your device unless you opt in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk ist standardmäßig privat. Keine Daten verlassen dein Gerät, sofern du dem nicht zustimmst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk はデフォルトでプライバシーを保護します。オプトインしない限り、データがデバイスの外に送信されることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk 默认保护隐私。除非你主动选择，否则任何数据都不会离开你的设备。"
          }
        }
      }
    },
    "VoiceInk modes include Dictation, Enhance, Email, Assistant, Rewrite, Ask, Summarize, and Translate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk-Modi umfassen Diktat, Verbesserung, E-Mail, Assistent, Umschreiben, Fragen, Zusammenfassen und Übersetzen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk のモードには、音声入力、AI整形、メール、アシスタント、書き換え、質問、要約、翻訳があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk 的模式包括听写、润色、邮件、助手、改写、提问、总结和翻译。"
          }
        }
      }
    },
    "VoiceInk needs at least one mode to record. Create one to start dictating.": {
      "comment": "A description of the benefits of creating a mode.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk benötigt mindestens einen Modus zum Aufnehmen. Erstelle einen, um mit dem Diktieren zu beginnen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音するにはモードが 1 つ以上必要です。モードを作成して音声入力を始めましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk 至少需要一个模式才能录音。创建一个模式即可开始听写。"
          }
        }
      }
    },
    "VoiceInk progress": {
      "comment": "A placeholder text that is displayed when the user has not recorded any VoiceInk sessions.",
      "isCommentAutoGenerated": true,
      "localizations": {
