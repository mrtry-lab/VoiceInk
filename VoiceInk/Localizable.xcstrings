        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的 %@ 文件未通过完整性验证。"
          }
        }
      }
    },
    "The downloaded size for %@ was %lld bytes instead of %lld bytes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die heruntergeladene Größe für %1$@ betrug %2$lld Byte statt %3$lld Byte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The downloaded size for %1$@ was %2$lld bytes instead of %3$lld bytes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のダウンロードサイズが %lld バイトでした（本来は %lld バイト）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的下载大小为 %2$lld 字节，而不是 %3$lld 字节。"
          }
        }
      }
    },
    "The imported settings file (version %@) is from a different version than your application (version %@). Proceeding with import, but be aware of potential incompatibilities.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die importierte Einstellungsdatei (Version %@) stammt aus einer anderen Version als deine Anwendung (Version %@). Der Import wird fortgesetzt, mögliche Inkompatibilitäten sind jedoch zu beachten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込んだ設定ファイル（バージョン %@）は、お使いのアプリケーション（バージョン %@）とは異なるバージョンのものです。読み込みを続行しますが、互換性の問題が生じる可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入的设置文件（版本 %@）与你的 App（版本 %@）版本不同。将继续导入，但请注意可能存在的不兼容问题。"
          }
        }
      }
    },
    "The key worked, but VoiceInk could not save it securely.": {
      "localizations": {
