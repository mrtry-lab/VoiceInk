    },
    "VoiceInk reads visible screen content to improve the accuracy of transcripts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk liest sichtbare Bildschirminhalte, um die Genauigkeit der Transkripte zu verbessern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
